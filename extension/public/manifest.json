{
  "manifest_version": 3,
  "name": "FingerNotes",
  "version": "1.0.0",
  "description": "Offline-first encrypted notes & expense tracker with peer-to-peer sync. No servers.",
  "minimum_chrome_version": "116",
  "action": { "default_popup": "popup.html", "default_title": "FingerNotes" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "alarms", "contextMenus", "sidePanel"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
